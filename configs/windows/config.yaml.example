# Windows Agent Configuration Example

# Agent Identity
code: "device-12345"  # Identity token used in NATS subjects (legacy key: device_id)
location: "hq"        # Optional deployment location, carried in heartbeat/telemetry payloads

# NATS Subject Prefix (optional)
# All NATS subjects will use this prefix: {prefix}.{code}.{subject}
# Default: "agents" (results in: agents.device-12345.heartbeat, agents.device-12345.cmd.ping, etc.)
# Supports hierarchical prefixes with dots: "region.env.agents" or "production.us-east.agents"
# Each token (separated by dots) can contain: alphanumeric, dashes, underscores
# Max 50 characters total. No leading/trailing dots or consecutive dots.
subject_prefix: "agents"

# NATS Connection
nats:
  urls: 
    - "nats://connect.your-service.com:4222"
  
  # Host a nats-server in this process (optional)
  #
  # Non-empty means the agent runs the server from this config file. On a
  # gateway that is the file `agent -leaf-config` wrote; it works equally with
  # any hand-written nats-server config, so this is also how you run a plain
  # embedded broker on a box with no platform. nats.urls must name the port it
  # listens on -- startup refuses the pair if they disagree.
  #
  # Leave it unset where systemd or Docker already supervises nats-server: the
  # bus then survives an agent restart, which is what you want when upgrading
  # the agent on a live site.
  #
  # server_config: "C:ProgramDataAgent/nats-leaf.conf"

  # Authentication (choose one method)
  auth:
    # Option 1: Credentials file (RECOMMENDED for production)
    type: "creds"
    creds_file: "C:\\ProgramData\\Agent\\device.creds"

    # Option 2: stone-age.io platform (fetches and maintains .creds).
    # The agent is a Thing on the platform: it logs in as itself against the
    # things collection and its credential lives on its nats_user relation.
    # Configure the platform itself in the top-level `platform:` block.
    # type: "platform"
    # creds_file: "C:\\ProgramData\\Agent\\device.creds"

    # Option 3: Token authentication
    # type: "token"
    # token: "your-token-here"

    # Option 4: Username/Password authentication
    # type: "userpass"
    # username: "user"
    # password: "pass"
  
  # TLS Configuration (optional but recommended for production)
  tls:
    # Enable TLS encryption
    enabled: false
    
    # Client certificate and key for mutual TLS authentication (optional)
    # Required if server requires client certificates
    cert_file: "C:\\ProgramData\\Agent\\client-cert.pem"
    key_file: "C:\\ProgramData\\Agent\\client-key.pem"
    
    # CA certificate for server verification (optional)
    # If not provided, system CA pool is used
    ca_file: "C:\\ProgramData\\Agent\\ca-cert.pem"
    
    # Skip server certificate verification (NOT RECOMMENDED for production)
    # Only use this for development/testing with self-signed certificates
    insecure_skip_verify: false
  
  # Optional: Custom connection options
  max_reconnects: -1  # -1 = infinite retries
  reconnect_wait: "2s"
  drain_timeout: "30s"

# Scheduled Tasks
tasks:
  # Heartbeat - Periodic "I'm alive" message
  heartbeat:
    enabled: true
    interval: "1m"  # Every 1 minute
  
  # System Metrics - CPU, memory, disk
  system_metrics:
    enabled: true
    interval: "5m"  # Every 5 minutes
  
  # Service Check - Monitor Windows services
  service_check:
    enabled: true
    interval: "1m"  # Every 1 minute
    services:  # List of services to monitor
      - "YourCriticalService"
      - "AnotherImportantService"
  
  # Inventory - System hardware/software inventory
  inventory:
    enabled: true
    interval: "24h"  # Daily (also runs on startup)

# Digital-twin sync (optional, off by default)
#
# Relays this site's reported state up to the hub and mirrors desired state
# down. Off by default because it moves data-plane traffic -- an upgrade must
# not silently start doing it. Requires the platform block.
twin:
  enabled: false

# Readiness and metrics on this box (optional)
#
# /ready and /metrics, served locally. This exists because cmd.health travels
# over NATS, which is the link that breaks: a box whose uplink is down is
# exactly the one you want to ask, and that is when it goes quiet.
#
# ON by default, on loopback. Set addr to "" to serve neither -- the checks
# still run and still log either way. A bind failure is logged, not fatal.
observability:
  addr: "127.0.0.1:9100"
  metrics_token: ""
  interval: "15s"

# Nebula Overlay Network (optional, disabled by default)
#
# Runs a Nebula mesh host inside the agent. The config is generated by the
# platform for this agent's thing and re-read on an interval, which is what
# makes certificate revocation, renewal and CA rotation actually reach the
# device: Nebula has no CRL, so a revoked certificate is only refused once
# each peer has re-read its own config.
#
# Requires root (Linux/FreeBSD) or, on Windows, wintun.dll beside the agent
# executable. See docs/nebula.md.
nebula:
  enabled: false

  # "platform" reads this agent's nebula_host record (requires platform auth).
  # "file" reads a config from disk and does not poll, cache or roll back.
  source: "platform"
  # config_file: "C:\\ProgramData\\Agent\\nebula.yaml"   # only for source: "file"

  # Last config known to have reached the mesh. Contains the host private key
  # and is written 0600. Lets a device that reboots while the platform is
  # unreachable still come up on the overlay.
  cache_file: "C:\\ProgramData\\Agent\\nebula-cache.yaml"

  # How often to check the platform for a new config. THIS IS THE REVOCATION
  # LATENCY for this device, not a tuning knob. 1m-1h.
  sync_interval: "10m"

  # How long a newly applied config has to reach a lighthouse before it is
  # restarted and then rolled back to the last one that worked. 5s-5m.
  verify_timeout: "30s"
# Command Execution
commands:
  # PowerShell Scripts Directory (optional)
  # If specified, any .ps1 file in this directory can be executed by filename
  # Example: Control plane sends command "Get-EventLog.ps1", agent executes
  #          C:\ProgramData\Agent\Scripts\Get-EventLog.ps1
  # Benefits: Scripts are version controlled, testable, and self-documenting
  # Security: Only .ps1 files in this exact directory are allowed (no subdirectories)
  scripts_directory: "C:\\ProgramData\\Agent\\Scripts"
  
  # Whitelist of services that can be controlled
  allowed_services:
    - "YourCriticalService"
    - "AnotherImportantService"
  
  # Whitelist of allowed PowerShell commands (exact match only)
  # For simple one-liners (< 5 operations), add them here
  # For complex commands (> 5 operations), use scripts_directory instead
  allowed_commands:
    - "ipconfig /all"
    - "Get-NetIPAddress | ConvertTo-Json -Compress"
    - "Get-Process | Sort-Object CPU -Descending | Select-Object -First 5 | ConvertTo-Json -Compress"
  
  # Allowed log file paths (glob patterns supported)
  allowed_log_paths:
    - "C:\\Logs\\*.log"
    - "C:\\ProgramData\\YourApp\\*.log"
  
  # Command execution timeout
  timeout: "30s"

# Logging
logging:
  level: "info"  # debug, info, warn, error
  file: "C:\\ProgramData\\Agent\\agent.log"
  max_size_mb: 100
  max_backups: 3
