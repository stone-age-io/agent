# Agent configuration example ("windows")
#
# Copy this file, set the three values marked EDIT, and start the agent. Every
# other setting is optional: a commented-out key shows its default, and a
# commented-out block is a feature that is off until you uncomment it.
#
# The three example files (linux, freebsd, windows) are identical apart from
# what is inside double quotes. A test enforces that, so edit all three.

code: "device-12345"            # EDIT: this agent's identity; used in NATS subjects
# location: "hq"                # optional single token, carried in telemetry
# subject_prefix: "agents"      # subjects are {prefix}.{code}.{type}

nats:
  urls:
    - "nats://nats.example.com:4222"   # EDIT

  auth:                         # EDIT: pick one
    type: "creds"
    creds_file: "C:\\ProgramData\\Agent\\device.creds"

    # The stone-age.io platform fetches and maintains the .creds file. The
    # agent logs in as its own Thing; configure the `platform:` block below.
    # type: "platform"
    # creds_file: "C:\\ProgramData\\Agent\\device.creds"

    # type: "token"
    # token: "your-token-here"

    # type: "userpass"
    # username: "user"
    # password: "pass"

    # type: "none"

  # tls:
  #   enabled: true
  #   ca_file: "C:\\ProgramData\\Agent\\ca-cert.pem"            # omit to use the system pool
  #   cert_file: "C:\\ProgramData\\Agent\\client-cert.pem"      # mutual TLS only
  #   key_file: "C:\\ProgramData\\Agent\\client-key.pem"        # mutual TLS only
  #   insecure_skip_verify: false               # development only

  # Host a nats-server in this process. On a gateway that is the file
  # `agent -leaf-config` wrote; any nats-server config works, so this is also
  # how to run a plain embedded broker. nats.urls must name the port it
  # listens on -- startup refuses the pair if they disagree. Leave it unset
  # where nats-server runs as its own service: the bus then survives an agent
  # restart, which is what you want when upgrading the agent on a live site.
  # server_config: "C:\\ProgramData\\Agent\\nats-leaf.conf"

  # max_reconnects: -1          # -1 = for ever
  # reconnect_wait: "2s"
  # drain_timeout: "30s"

# stone-age.io platform (optional)
#
# One home for the platform relationship. Three things read it: the NATS
# credential lifecycle (auth type "platform"), the Nebula config source
# (nebula.source "platform"), and the leaf bootstrap (agent -leaf-config).
#
# platform:
#   url: "https://platform.example.com"
#   identity: "thing@example.com"                 # the thing's login email
#   password_env: "AGENT_PLATFORM_PASSWORD"       # env var holding the password;
#                                                 # optional after first boot
#   sync_interval: "24h"                          # credential refresh, 1h-72h
#   leaf_refresh_interval: "5m"                   # gateways: re-read the leaf's
#                                                 # account JWT (revocations) and
#                                                 # reload the leaf. 0 = off, else
#                                                 # 30s-1h. THIS IS THE SITE'S
#                                                 # REVOCATION LATENCY
#   # session_file: default is beside nats.auth.creds_file
#   # allow_insecure_url: false                   # http:// URL, development only

# Scheduled tasks. Each shows its default.
# tasks:
#   heartbeat:                  # Core NATS liveness beacon
#     enabled: true
#     interval: "1m"            # minimum 10s
#   system_metrics:             # CPU, memory, disk
#     enabled: true
#     interval: "5m"            # minimum 30s
#   inventory:                  # hardware/software inventory, also at startup
#     enabled: true
#     interval: "24h"
#   service_check:              # runs only when services are listed
#     interval: "1m"
#     services:                 # names as "the Service Control Manager" knows them
#       - "W32Time"

# Commands the control plane may run. Everything is refused unless listed.
# commands:
#   timeout: "30s"              # 5s-5m
#
#   # Scripts are requested by bare filename (e.g. "Deploy.ps1") and must sit
#   # directly in this directory. Unset = no scripts. If set, it must exist.
#   scripts_directory: "C:\\ProgramData\\Agent\\Scripts"
#
#   allowed_services:           # start/stop/restart/status
#     - "W32Time"
#
#   allowed_commands:           # exact match, run through "PowerShell"
#     - "ipconfig /all"
#
#   allowed_log_paths:          # glob patterns
#     - "C:\\Logs\\*.log"

# KV sync (optional, off by default)
#
# Relays declared buckets up to the hub and mirrors declared buckets down.
# Off by default because it moves data-plane traffic -- an upgrade must not
# silently start doing it. Requires the platform block.
# sync:
#   twin: true                 # preset: the two digital-twin buckets
#   mirrors:                   # hub -> edge, maintained by the server
#     - bucket: "recipes"
#       keys: "line-a.>"       # optional; CANNOT be changed after creation
#   relays:                    # edge -> hub, pumped by the agent
#     - bucket: "events"
#       keys: "site.S01.>"     # optional. A bucket belongs to ONE list.

# Readiness and metrics on this box: /ready and /metrics
#
# This exists because cmd.health travels over NATS, which is the link that
# breaks: a box whose uplink is down is exactly the one you want to ask.
#
# ON by default, on loopback. Set addr to "" to serve neither -- the checks
# still run and still log either way. A bind failure is logged, not fatal.
# observability:
#   addr: "127.0.0.1:10063"
#   metrics_token: ""           # empty = open; Bearer or Basic when set
#   interval: "15s"

# Nebula overlay network (optional, off by default)
#
# Runs a Nebula mesh host inside the agent. Nebula has no CRL, so a revoked
# certificate is only refused once each peer re-reads its own config; the
# agent re-reads its config on sync_interval. Requires root, or wintun.dll
# beside the agent executable on Windows. See docs/nebula.md.
# nebula:
#   enabled: true
#   source: "platform"          # "platform" (needs the platform block) or "file"
#   # config_file: "C:\\ProgramData\\Agent\\nebula.yaml"         # only for source "file"
#   cache_file: "C:\\ProgramData\\Agent\\nebula-cache.yaml"     # last config that reached the
#                                                # mesh; holds the private key
#   sync_interval: "10m"        # 1m-1h. THIS IS THE REVOCATION LATENCY
#   verify_timeout: "30s"       # 5s-5m before restart, then rollback

# logging:
#   level: "info"               # debug, info, warn, error
#   file: "C:\\ProgramData\\Agent\\agent.log"
#   max_size_mb: 100
#   max_backups: 3
