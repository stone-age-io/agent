# Linux Agent Configuration Example

# Agent Identity
code: "device-12345"  # Identity token used in NATS subjects (legacy key: device_id)
location: "hq"        # Optional deployment location, carried in heartbeat/telemetry payloads

# NATS Subject Prefix (optional)
subject_prefix: "agents"

# stone-age.io Platform (optional)
#
# One home for the platform relationship. Three subsystems read it: the NATS
# credential lifecycle (nats.auth.type: "platform"), the Nebula config source
# (nebula.source: "platform"), and the leaf bootstrap (agent -leaf-config).
# Leave the block out entirely and none of them are available.
#
# platform:
#   url: "https://platform.example.com"
#   identity: "thing@example.com"                 # the thing's login email
#   password_env: "AGENT_PLATFORM_PASSWORD"       # reads the password from this env var
#   sync_interval: "24h"                          # credential refresh, 1h-72h
#   # session_file: default is beside nats.auth.creds_file
#   # allow_insecure_url: false                   # http:// platform URL, development only

# NATS Connection
nats:
  urls: 
    - "nats://connect.your-service.com:4222"
  
  # Authentication (choose one method)
  auth:
    # Option 1: Credentials file (RECOMMENDED for production)
    type: "creds"
    creds_file: "/etc/agent/device.creds"

    # Option 2: stone-age.io platform (fetches and maintains .creds).
    # The agent is a Thing on the platform: it logs in as itself against the
    # things collection and its credential lives on its nats_user relation.
    # Configure the platform itself in the top-level `platform:` block.
    # type: "platform"
    # creds_file: "/etc/agent/device.creds"

    # Option 3: Token authentication
    # type: "token"
    # token: "your-token-here"

    # Option 4: Username/Password authentication
    # type: "userpass"
    # username: "user"
    # password: "pass"
  
  # TLS Configuration (optional but recommended for production)
  tls:
    enabled: false
    cert_file: "/etc/agent/client-cert.pem"
    key_file: "/etc/agent/client-key.pem"
    ca_file: "/etc/agent/ca-cert.pem"
    insecure_skip_verify: false
  
  max_reconnects: -1
  reconnect_wait: "2s"
  drain_timeout: "30s"

# Scheduled Tasks
tasks:
  # Heartbeat - Periodic "I'm alive" message
  heartbeat:
    enabled: true
    interval: "1m"
  
  # System Metrics - CPU, memory, disk
  system_metrics:
    enabled: true
    interval: "5m"
    source: "builtin"  # "builtin" (gopsutil, default) or "exporter" (scrape node_exporter)
    # exporter_url: "http://localhost:9100/metrics"  # Only used when source: "exporter"
  
  # Service Check - Monitor systemd services
  service_check:
    enabled: true
    interval: "1m"
    services:
      - "nginx"
      - "postgresql"
      - "redis"
  
  # Inventory - System hardware/software inventory
  inventory:
    enabled: true
    interval: "24h"


# Host a nats-server in this process (optional)
#
# Non-empty means the agent runs the server from this config file. On a gateway
# that is the file `agent -leaf-config` wrote; it works equally with any
# hand-written nats-server config. nats.urls must name the port it listens on --
# startup refuses the pair if they disagree.
#
# Leave it empty where systemd or Docker already supervises nats-server: the bus
# then survives an agent restart, which is what you want when upgrading the
# agent on a live site.
#
#   nats:
#     server_config: "/etc/agent/nats-leaf.conf"

# Digital-twin sync (optional, off by default)
#
# Relays this site's reported state up to the hub and mirrors desired state
# down. Off by default because it moves data-plane traffic -- an upgrade must
# not silently start doing it. Requires the platform block.
twin:
  enabled: false

# Readiness and metrics on this box (optional)
#
# /ready and /metrics, served locally. This exists because cmd.health travels
# over NATS, which is the link that breaks: a box whose uplink is down is
# exactly the one you want to ask, and that is when it goes quiet.
#
# addr empty serves neither -- the checks still run and still log. Loopback by
# default: opening a port on an appliance should be a decision.
observability:
  addr: "127.0.0.1:9100"
  metrics_token: ""
  interval: "15s"

# Nebula Overlay Network (optional, disabled by default)
#
# Runs a Nebula mesh host inside the agent. The config is generated by the
# platform for this agent's thing and re-read on an interval, which is what
# makes certificate revocation, renewal and CA rotation actually reach the
# device: Nebula has no CRL, so a revoked certificate is only refused once
# each peer has re-read its own config.
#
# Requires root (Linux/FreeBSD) or, on Windows, wintun.dll beside the agent
# executable. See docs/nebula.md.
nebula:
  enabled: false

  # "platform" reads this agent's nebula_host record (requires platform auth).
  # "file" reads a config from disk and does not poll, cache or roll back.
  source: "platform"
  # config_file: "/etc/agent/nebula.yaml"   # only for source: "file"

  # Last config known to have reached the mesh. Contains the host private key
  # and is written 0600. Lets a device that reboots while the platform is
  # unreachable still come up on the overlay.
  cache_file: "/var/lib/agent/nebula-cache.yaml"

  # How often to check the platform for a new config. THIS IS THE REVOCATION
  # LATENCY for this device, not a tuning knob. 1m-1h.
  sync_interval: "10m"

  # How long a newly applied config has to reach a lighthouse before it is
  # restarted and then rolled back to the last one that worked. 5s-5m.
  verify_timeout: "30s"
# Command Execution
commands:
  # Scripts Directory (optional)
  scripts_directory: "/opt/agent/scripts"
  
  # Whitelist of services that can be controlled
  allowed_services:
    - "nginx"
    - "postgresql"
    - "redis"
  
  # Whitelist of allowed shell commands
  allowed_commands:
    - "df -h | grep -E '^/dev/'"
    - "uptime"
    - "ps aux | sort -rk 3 | head -10"
  
  # Allowed log file paths (glob patterns supported)
  allowed_log_paths:
    - "/var/log/nginx/*.log"
    - "/var/log/app/*.log"
  
  # Command execution timeout
  timeout: "30s"

# Logging
logging:
  level: "info"  # debug, info, warn, error
  file: "/var/log/agent/agent.log"
  max_size_mb: 100
  max_backups: 3
